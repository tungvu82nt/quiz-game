VITE_ANALYSIS_API_URL=https://your-analysis-api.example.com/
VITE_ANALYSIS_API_PATH=chat/completions
VITE_ANALYSIS_MODEL=MiniMax-M2
VITE_ANALYSIS_API_KEY=your_api_key_here
VITE_PROMPT_STYLE=concise # hoặc 'default' (chi tiết) / 'narrative' (Bên trong/Bên ngoài/Giả thuyết tổng thể)
VITE_ANALYSIS_USE_MOCK=0 # đặt 1 để dùng mô phỏng (mock) khi cần demo hoặc tránh CORS
